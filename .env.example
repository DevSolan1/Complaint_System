DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Email (console backend by default; switch to SMTP for real delivery)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@complaints.local

# Production only (config/settings/production.py)
DATABASE_URL=postgres://user:password@localhost:5432/complaints
DJANGO_SECURE_SSL_REDIRECT=True
